# ── FrameFinder production env ──────────────────────────────────────
# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Supabase (from your Supabase project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key
# Service-role key — SERVER ONLY. Used by the Razorpay webhook (no user session there).
# Never expose to the browser; never commit.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key

# Razorpay (from Razorpay Dashboard → Settings → API Keys)
# Publishable key — safe to expose in the browser via NEXT_PUBLIC_*
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Secret key — SERVER ONLY. Used for order creation + payment verification.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret — SERVER ONLY. Set in Razorpay Dashboard → Settings → Webhooks,
# then paste the same value here. Used to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Public app URL (used for auth redirect + absolute links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
